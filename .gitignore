# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data and outputs (per-dataset subdirs: data/mnist/, checkpoints/mnist/, etc.)
data/
data/*/
checkpoints/*/
samples/*/
results/
logs/
*.out
*.err
*.log

# HDF5 and datasets
*.h5
*.hdf5
*.pt

# Wandb
wandb/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# LaTeX build artifacts (keep source and final PDFs, ignore build intermediates)
reports/**/*.aux
reports/**/*.log
reports/**/*.out
reports/**/*.toc
reports/**/*.synctex.gz
reports/**/*.fdb_latexmk
reports/**/*.fls
reports/**/*.bbl
reports/**/*.blg

# Keep LaTeX sources, figures, and PDFs
!reports/**/*.tex
!reports/**/*.pdf
!reports/**/*.png
!reports/**/*.jpg
!reports/**/*.gif
!reports/**/*.mp4

# Keep structure (.gitkeep files)
!data/.gitkeep
!logs/.gitkeep
!checkpoints/.gitkeep
!samples/.gitkeep
!results/.gitkeep

# OS
.DS_Store
Thumbs.db
